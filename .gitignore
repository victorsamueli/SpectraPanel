# Ignore all Excel workbooks by default to protect personal lab data
*.xlsx
*.xls
*.xlsm
~$*.xlsx
~$*.xls

# Allow only the public dummy/demo database workbook
!data/SpectraPanel_Demo_Database.xlsx

# Python and virtual environment caches
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# Operating system files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary & test files
test_*.html
*.tmp
